@page
@model Hrdr.Pages.Items.IndexModel
@{
    ViewData["Title"] = "Work items";
}

<div class="page-toolbar">
    <h1>Work items</h1>
    <a class="btn" asp-page="Create" asp-route-projectId="@Model.ProjectId">New item</a>
</div>

<form method="get" class="filters" style="margin-bottom: 1.25rem;">
    <div class="field">
        <label asp-for="ProjectId">Project</label>
        <select asp-for="ProjectId" asp-items="Model.ProjectOptions" onchange="this.form.submit()">
            <option value="">All projects</option>
        </select>
    </div>
    <div class="field">
        <label asp-for="Type">Type</label>
        <select asp-for="Type" onchange="this.form.submit()">
            <option value="">All</option>
            <option value="Feature">Feature</option>
            <option value="Bug">Bug</option>
        </select>
    </div>
</form>

@if (!Model.CanReorder)
{
    @if (Model.ProjectId is null or <= 0)
    {
        <p class="note">Drag items between columns to change state. Select a project to also reorder items within columns. Column headers can be dragged to change board order.</p>
    }
    else if (Model.Type is not null)
    {
        <p class="note">Drag items between columns to change state. Clear the type filter to reorder the full project list.</p>
    }
}

@if (Model.Items.Count == 0)
{
    <p class="empty">No work items match these filters.</p>
}

<div class="kanban-board"
     @if (Model.CanReorder)
     {
         <text>data-project-id="@Model.ProjectId" data-ordered-ids="@string.Join(',', Model.Items.Select(i => i.Id))"</text>
     }>
    @foreach (var column in Model.Columns)
    {
        <section class="kanban-column" data-state="@column.State.ToDisplayString()">
            <header class="kanban-column-header" title="Drag to reorder columns">
                <button type="button"
                        class="kanban-collapse-toggle"
                        aria-expanded="true"
                        aria-label="Collapse @column.State.ToDisplayString() column"
                        title="Collapse column">
                    <span class="kanban-collapse-icon" aria-hidden="true">◀</span>
                </button>
                <h2>@column.State.ToDisplayString()</h2>
                <span class="kanban-count">@column.Items.Count</span>
            </header>
            <ul class="kanban-cards sortable">
                @foreach (var item in column.Items)
                {
                    <li class="kanban-card" data-id="@item.Id">
                        <p class="item-title">
                            <span class="drag-hint" aria-hidden="true">⋮⋮</span>
                            <span class="item-id">#@item.Id</span>
                            @item.Title
                        </p>
                        <div class="item-meta">
                            <span class="badge @(item.Type == WorkItemType.Bug ? "badge-bug" : "badge-feature")">@item.Type</span>
                            @if (Model.ProjectId is null)
                            {
                                <span>@item.ProjectName</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <span>@(item.Description.Length > 80 ? item.Description[..80] + "…" : item.Description)</span>
                            }
                        </div>
                        <div class="actions">
                            <a class="btn btn-secondary btn-sm" asp-page="Edit" asp-route-id="@item.Id">Edit</a>
                            <form method="post" asp-page-handler="Delete" class="inline-form"
                                  onsubmit="return confirm('Delete this item?');">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                                <input type="hidden" name="Type" value="@Model.Type" />
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        </section>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>
    <script>
        (function () {
            var storageKey = 'hrdr.kanban.collapsedColumns';
            var board = document.querySelector('.kanban-board');
            if (!board) return;

            var suppressCollapseClick = false;

            function readCollapsed() {
                try {
                    var raw = localStorage.getItem(storageKey);
                    if (!raw) return {};
                    var parsed = JSON.parse(raw);
                    var map = {};
                    if (Array.isArray(parsed)) {
                        parsed.forEach(function (state) { map[state] = true; });
                    }
                    return map;
                } catch (e) {
                    return {};
                }
            }

            function writeCollapsed(map) {
                try {
                    localStorage.setItem(storageKey, JSON.stringify(Object.keys(map)));
                } catch (e) {
                    /* ignore quota / private mode */
                }
            }

            function columnLabel(column) {
                var heading = column.querySelector('h2');
                return (heading && heading.textContent) ? heading.textContent.trim() : 'column';
            }

            function setCollapsed(column, collapsed) {
                var state = column.getAttribute('data-state');
                var toggle = column.querySelector('.kanban-collapse-toggle');
                var label = columnLabel(column);
                if (collapsed) column.classList.add('is-collapsed');
                else column.classList.remove('is-collapsed');
                if (toggle) {
                    toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
                    toggle.setAttribute(
                        'aria-label',
                        (collapsed ? 'Expand ' : 'Collapse ') + label + ' column');
                    toggle.title = collapsed ? 'Expand column' : 'Collapse column';
                }
                if (state) {
                    var collapsedStates = readCollapsed();
                    if (collapsed) collapsedStates[state] = true;
                    else delete collapsedStates[state];
                    writeCollapsed(collapsedStates);
                }
            }

            var collapsedStates = readCollapsed();
            board.querySelectorAll('.kanban-column[data-state]').forEach(function (column) {
                var state = column.getAttribute('data-state');
                if (state && collapsedStates[state]) {
                    setCollapsed(column, true);
                }
            });

            board.addEventListener('click', function (event) {
                if (suppressCollapseClick) return;
                var header = event.target.closest('.kanban-column-header');
                if (!header || !board.contains(header)) return;
                var column = header.closest('.kanban-column');
                if (!column) return;
                event.preventDefault();
                setCollapsed(column, !column.classList.contains('is-collapsed'));
            });

            async function persistColumnOrder(orderedStates) {
                var res = await fetch('/api/board/column-order', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderedStates: orderedStates })
                });
                if (!res.ok) {
                    alert('Column reorder failed. Reloading…');
                    location.reload();
                }
            }

            Sortable.create(board, {
                animation: 150,
                draggable: '.kanban-column',
                handle: '.kanban-column-header',
                direction: 'horizontal',
                ghostClass: 'sortable-ghost',
                chosenClass: 'sortable-chosen',
                distance: 8,
                onEnd: async function (evt) {
                    if (evt.oldIndex === evt.newIndex) return;
                    suppressCollapseClick = true;
                    setTimeout(function () { suppressCollapseClick = false; }, 0);
                    var orderedStates = Array.from(board.querySelectorAll('.kanban-column[data-state]'))
                        .map(function (col) { return col.getAttribute('data-state'); })
                        .filter(Boolean);
                    await persistColumnOrder(orderedStates);
                }
            });
        })();
    </script>
    <script>
        (function () {
            const board = document.querySelector('.kanban-board');
            if (!board) return;
            const projectId = board.dataset.projectId;
            const canReorder = Boolean(projectId);

            function readOrder() {
                return (board.dataset.orderedIds || '')
                    .split(',')
                    .filter(Boolean)
                    .map(id => parseInt(id, 10));
            }

            function writeOrder(ids) {
                board.dataset.orderedIds = ids.join(',');
            }

            function updateColumnCount(column) {
                if (!column) return;
                const countEl = column.querySelector('.kanban-count');
                if (!countEl) return;
                countEl.textContent = String(column.querySelectorAll('.kanban-cards > li[data-id]').length);
            }

            async function persistState(itemId, state) {
                const res = await fetch('/api/items/' + itemId, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ state })
                });
                if (!res.ok) {
                    alert('State update failed. Reloading…');
                    location.reload();
                    return false;
                }
                return true;
            }

            async function persistOrder(orderedIds) {
                const res = await fetch('/api/projects/' + projectId + '/items/reorder', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderedIds })
                });
                if (!res.ok) {
                    alert('Reorder failed. Reloading…');
                    location.reload();
                }
            }

            function mergeOrderAfterMove(evt) {
                const fullOrder = readOrder();
                if (evt.from === evt.to) {
                    const newColumnIds = Array.from(evt.to.querySelectorAll('li[data-id]'))
                        .map(li => parseInt(li.dataset.id, 10));
                    const columnSet = new Set(newColumnIds);
                    let i = 0;
                    return fullOrder.map(id => columnSet.has(id) ? newColumnIds[i++] : id);
                }

                const itemId = parseInt(evt.item.dataset.id, 10);
                const toIds = Array.from(evt.to.querySelectorAll('li[data-id]'))
                    .map(li => parseInt(li.dataset.id, 10));
                const without = fullOrder.filter(id => id !== itemId);
                const idxInTo = toIds.indexOf(itemId);
                let insertAt;
                if (idxInTo <= 0) {
                    if (toIds.length <= 1) {
                        insertAt = without.length;
                    } else {
                        const nextId = toIds[1];
                        insertAt = without.indexOf(nextId);
                        if (insertAt < 0) insertAt = without.length;
                    }
                } else {
                    const prevId = toIds[idxInTo - 1];
                    insertAt = without.indexOf(prevId) + 1;
                    if (insertAt <= 0) insertAt = without.length;
                }
                without.splice(insertAt, 0, itemId);
                return without;
            }

            board.querySelectorAll('.kanban-cards.sortable').forEach(list => {
                Sortable.create(list, {
                    group: 'kanban-cards',
                    animation: 150,
                    ghostClass: 'sortable-ghost',
                    chosenClass: 'sortable-chosen',
                    filter: 'a, button, input, form',
                    preventOnFilter: false,
                    onEnd: async function (evt) {
                        if (evt.from === evt.to && evt.oldIndex === evt.newIndex) return;

                        const itemId = parseInt(evt.item.dataset.id, 10);
                        const fromColumn = evt.from.closest('.kanban-column');
                        const toColumn = evt.to.closest('.kanban-column');
                        const oldState = fromColumn && fromColumn.getAttribute('data-state');
                        const newState = toColumn && toColumn.getAttribute('data-state');

                        if (oldState !== newState && newState) {
                            const ok = await persistState(itemId, newState);
                            if (!ok) return;
                            updateColumnCount(fromColumn);
                            updateColumnCount(toColumn);
                        }

                        if (!canReorder) return;

                        const merged = mergeOrderAfterMove(evt);
                        writeOrder(merged);
                        await persistOrder(merged);
                    }
                });
            });
        })();
    </script>
}

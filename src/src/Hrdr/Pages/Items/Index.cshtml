@page
@model Hrdr.Pages.Items.IndexModel
@{
    ViewData["Title"] = "Work items";
}

<div class="page-toolbar">
    <h1>Work items</h1>
    <a class="btn" asp-page="Create" asp-route-projectId="@Model.ProjectId">New item</a>
</div>

<form method="get" class="filters" style="margin-bottom: 1.25rem;">
    <div class="field">
        <label asp-for="ProjectId">Project</label>
        <select asp-for="ProjectId" asp-items="Model.ProjectOptions" onchange="this.form.submit()">
            <option value="">All projects</option>
        </select>
    </div>
    <div class="field">
        <label asp-for="Type">Type</label>
        <select asp-for="Type" onchange="this.form.submit()">
            <option value="">All</option>
            <option value="Feature">Feature</option>
            <option value="Bug">Bug</option>
        </select>
    </div>
</form>

@if (!Model.CanReorder)
{
    <p class="note">Select a project to enable drag-and-drop reordering.</p>
}
else if (Model.Type is not null)
{
    <p class="note">Clear the type filter to reorder the full project list.</p>
}

@if (Model.Items.Count == 0)
{
    <p class="empty">No work items match these filters.</p>
}
else
{
    <ul id="item-list"
        class="item-list @(Model.CanReorder && Model.Type is null ? "sortable" : null)"
        data-project-id="@(Model.CanReorder ? Model.ProjectId : null)">
        @foreach (var item in Model.Items)
        {
            <li data-id="@item.Id">
                <div class="item-main">
                    <p class="item-title">
                        @if (Model.CanReorder && Model.Type is null)
                        {
                            <span class="drag-hint" aria-hidden="true">⋮⋮</span>
                        }
                        <span class="item-id">#@item.Id</span>
                        @item.Title
                    </p>
                    <div class="item-meta">
                        <span class="badge @(item.Type == WorkItemType.Bug ? "badge-bug" : "badge-feature")">@item.Type</span>
                        @if (!Model.CanReorder)
                        {
                            <span>@item.ProjectName</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <span>@(item.Description.Length > 80 ? item.Description[..80] + "…" : item.Description)</span>
                        }
                    </div>
                </div>
                <div class="actions">
                    <a class="btn btn-secondary btn-sm" asp-page="Edit" asp-route-id="@item.Id">Edit</a>
                    <form method="post" asp-page-handler="Delete" class="inline-form"
                          onsubmit="return confirm('Delete this item?');">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                        <input type="hidden" name="Type" value="@Model.Type" />
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </div>
            </li>
        }
    </ul>
}

@section Scripts {
    @if (Model.CanReorder && Model.Type is null)
    {
        <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>
        <script>
            (function () {
                const list = document.getElementById('item-list');
                if (!list) return;
                const projectId = list.dataset.projectId;
                Sortable.create(list, {
                    animation: 150,
                    ghostClass: 'sortable-ghost',
                    chosenClass: 'sortable-chosen',
                    onEnd: async function () {
                        const orderedIds = Array.from(list.querySelectorAll('li[data-id]'))
                            .map(li => parseInt(li.dataset.id, 10));
                        const res = await fetch('/api/projects/' + projectId + '/items/reorder', {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ orderedIds })
                        });
                        if (!res.ok) {
                            alert('Reorder failed. Reloading…');
                            location.reload();
                        }
                    }
                });
            })();
        </script>
    }
}

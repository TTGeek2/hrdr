@page "{id:int}"
@model Hrdr.Pages.Items.EditModel
@{
    ViewData["Title"] = "Edit item";
}

<h1>Edit item</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <p class="alert-error">@Model.ErrorMessage</p>
}

<form method="post" class="form-panel">
    <input type="hidden" asp-for="Id" />
    <div class="field">
        <label asp-for="Input.Title">Title</label>
        <input asp-for="Input.Title" autofocus />
    </div>
    <div class="field">
        <label asp-for="Input.Description">Description</label>
        <textarea asp-for="Input.Description"></textarea>
    </div>
    <div class="field">
        <label asp-for="Input.Type">Type</label>
        <select asp-for="Input.Type" asp-items="Html.GetEnumSelectList<WorkItemType>()"></select>
    </div>
    <div class="field">
        <label asp-for="Input.State">State</label>
        <select asp-for="Input.State" asp-items="Html.GetEnumSelectList<WorkItemState>()"></select>
    </div>
    <div class="field">
        <label asp-for="Input.ProjectId">Project</label>
        <select asp-for="Input.ProjectId" asp-items="Model.ProjectOptions"></select>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn">Save</button>
        <a class="btn btn-secondary" asp-page="Index" asp-route-projectId="@Model.Input.ProjectId">Cancel</a>
    </div>
</form>

<section class="comments-section form-panel">
    <h2>Comments</h2>

    @if (!string.IsNullOrEmpty(Model.CommentErrorMessage))
    {
        <p class="alert-error">@Model.CommentErrorMessage</p>
    }

    @if (Model.Comments.Count == 0)
    {
        <p class="empty">No comments yet.</p>
    }
    else
    {
        <ul class="comment-list">
            @foreach (var comment in Model.Comments)
            {
                <li>
                    <div class="comment-main">
                        <p class="comment-body">@comment.Body</p>
                        <p class="item-meta">@comment.CreatedAt.ToLocalTime().ToString("g")</p>
                    </div>
                    <form method="post" asp-page-handler="DeleteComment" class="inline-form"
                          onsubmit="return confirm('Delete this comment?');">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" name="commentId" value="@comment.Id" />
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </li>
            }
        </ul>
    }

    <form method="post" asp-page-handler="AddComment" class="comment-form">
        <input type="hidden" asp-for="Id" />
        <div class="field">
            <label asp-for="NewCommentBody">Add comment</label>
            <textarea asp-for="NewCommentBody" rows="3"></textarea>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">Add comment</button>
        </div>
    </form>
</section>
